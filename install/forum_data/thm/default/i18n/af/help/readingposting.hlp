  </tr>
  <tr>
    <td valign="middle" align="center"><font color="#FF0000">http://fudforum.org</font></td>
    <td valign="middle" align="center"><a href="http://fudforum.org" target=_blank>http://fudforum.org</a></td>
  </tr>
</table>
